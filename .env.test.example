# テスト実行専用のDATABASE_URLを設定する任意ファイル。
#   cp .env.test.example .env.test
# .env.testはGitにコミットしないでください(.gitignoreで除外済み)。
#
# 用途: tests/integration/test_user_isolation.py や
# tests/unit/test_migrations.py はDATABASE_URLへ実際にデータを書き込み、
# 後者はさらに全テーブルをdrop/再作成する(alembic downgrade base →
# upgrade head)。.envに日常使っているDBを設定していると、pytest実行の
# たびにそのDBが空にリセットされてしまう。
#
# このファイルを作成し、使い捨てて構わない別のDB(Neonの別ブランチ・
# 別プロジェクト、ローカルPostgres等)を指定しておくと、tests/conftest.py
# が起動時に.envのDATABASE_URLをこちらで上書きするため、pytestが
# 日常用DBに触れなくなる。設定しなければ従来通り.envのDATABASE_URLが
# そのままテストにも使われる(CI等、このファイルが無い環境向けの既定動作)。
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require
