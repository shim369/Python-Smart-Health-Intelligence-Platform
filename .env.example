# このファイルをコピーして .env を作成し、実際の値を設定してください。
#   cp .env.example .env
# .env はGitにコミットしないでください(.gitignoreで除外済み)。

# --- Database (Neon等のPostgreSQL接続文字列) ---
# psycopg3ドライバーを使用するため postgresql+psycopg:// で始める。
# Neonの接続文字列(postgresql://...)を使う場合はスキーム部分を
# postgresql+psycopg:// に読み替えること。NeonはSSL接続必須のため
# sslmode=require を付ける。
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require

# --- Gemini API ---
GEMINI_API_KEY=

# --- AI Provider切り替え ---
# "gemini"(既定)または "fake"。fakeを指定するとAPIキー無しで
# FakeAIProviderを使って動作確認できる(config.py参照)。
AI_PROVIDER=gemini

# --- ログレベル ---
# DEBUG / INFO / WARNING / ERROR。未設定時はINFO(logging_config.py参照)。
LOG_LEVEL=INFO
