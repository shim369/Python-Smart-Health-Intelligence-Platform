# このファイルをコピーして .streamlit/secrets.toml を作成し、実際の値を設定してください。
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# .streamlit/secrets.toml はGitにコミットしないでください(.gitignoreで除外済み)。
#
# Google OAuthクライアントの作成手順はdocs/auth-migration-design.mdを参照。
# cookie_secretはランダムな文字列であれば何でもよい(生成例: `python -c "import secrets; print(secrets.token_hex(32))"`)。

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "ランダムな文字列に置き換える"
client_id = "xxxxx.apps.googleusercontent.com"
client_secret = "xxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# 任意。設定しなければ誰でもログイン可能。
allowed_emails = "your-email@gmail.com,friend@gmail.com"
